{
  "name": "@sard/sandbox",
  "version": "0.0.1",
  "description": "Process isolation wrapper for untrusted code execution (WP plugins, user jobs)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pidusage": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "license": "MIT"
}
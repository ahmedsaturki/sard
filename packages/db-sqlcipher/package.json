{
  "name": "@sard/db-sqlcipher",
  "version": "0.0.1",
  "description": "SQLCipher WASM worker pool + Payload Database Adapter for Sard Lite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "import": "./dist/payload.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "sqlcipher-wasm": "github:7mind/sqlcipher-wasm#main",
    "drizzle-orm": "^0.38.3",
    "@libsql/client": "^0.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "eslint": "^9.18.0",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  },
  "license": "MIT"
}
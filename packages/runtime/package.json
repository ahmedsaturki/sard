{
  "name": "@sard-cms/runtime",
  "version": "0.0.1",
  "description": "Sard runtime package",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "drizzle-orm": "^0.38.3",
    "@libsql/client": "^0.14.0",
    "pg": "^8.13.1",
    "@sard-cms/db": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/pg": "^8.11.10"
  },
  "license": "MIT"
}
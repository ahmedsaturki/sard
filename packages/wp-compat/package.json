{
  "name": "@sard/wp-compat",
  "version": "0.0.1",
  "description": "WordPress Compatibility Layer - L2: Theme to Astro Conversion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sard/core": "workspace:*",
    "@sard/design-tokens": "workspace:*",
    "postcss": "^8.4.47",
    "postcss-value-parser": "^4.2.0",
    "css-tree": "^2.3.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "license": "MIT"
}
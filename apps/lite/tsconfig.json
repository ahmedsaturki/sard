{
  "extends": "../../tools/tsconfig/nextjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@payload-config": [
        "./payload.config.ts"
      ],
      "@importMap": [
        "./src/app/(payload)/sard-import-map.js"
      ],
      "@/importMap": [
        "./src/app/(payload)/sard-import-map.js"
      ]
    },
    "noEmit": true
  },
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  },
  "plugins": [
    {
      "name": "next"
    }
  ],
  "types": [
    "node",
    "next",
    "next/image-types/global"
  ],
  "noEmit": true,
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "staticDistDir": "./apps/lite/public"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.98 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 1.0 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1000 }],
        "interactive": ["error", { "maxNumericValue": 100 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 500000 }],
        "resource-summary:script:transfer-size": ["warn", { "maxNumericValue": 150000 }],
        "resource-summary:stylesheet:transfer-size": ["warn", { maxNumericValue: 50000 }]
      }
    }
  }
}

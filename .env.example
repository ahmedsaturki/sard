# Sard environment
# Copy to .env and adjust

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sard

# Auth (set a strong value in production!)
SARD_SECRET_KEY=change-me-to-a-256-bit-secret
SARD_SESSION_TTL_HOURS=24

# Site
SARD_SITE_URL=http://localhost:4321
SARD_DEFAULT_LOCALE=ar
SARD_LOCALES=ar,en

# Storage (media)
SARD_MEDIA_DIR=./storage/media
#SARD_MEDIA_S3_ENDPOINT=
#SARD_MEDIA_S3_BUCKET=
#SARD_MEDIA_S3_ACCESS_KEY=
#SARD_MEDIA_S3_SECRET_KEY=

{
  "name": "sard-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Sard — Content Operating System by Bunya Labs",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky",
    "db:generate": "cd packages/db-sqlcipher && drizzle-kit generate",
    "db:migrate": "cd packages/db-sqlcipher && tsx src/migrate.ts",
    "db:seed": "cd packages/db-sqlcipher && tsx src/seed.ts",
    "db:studio": "cd packages/db-sqlcipher && drizzle-kit studio",
    "lite:dev": "cd apps/lite && pnpm dev",
    "lite:build": "cd apps/lite && pnpm build",
    "lite:start": "cd apps/lite && pnpm start",
    "install:lite": "cd apps/lite && pnpm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@libsql/client": "^0.14.0",
    "@node-rs/argon2": "^2.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.4",
  "license": "MIT",
  "author": "Bunya Labs",
  "homepage": "https://sard.bunya.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunya-labs/sard"
  },
  "keywords": [
    "cms",
    "content",
    "edge",
    "typescript",
    "astro",
    "portable-text"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {},
  "pnpm": {
    "overrides": {
      "@payloadcms/db-sqlite": "^3.92.0",
      "@payloadcms/richtext-lexical": "^3.92.0",
      "@payloadcms/translations": "^3.92.0",
      "payload": "^3.92.0",
      "express": "^4.21.2",
      "express-rate-limit": "^7.5.1",
      "helmet": "^8.3.0"
    }
  }
}
